# FerrisMind project repository ignores

# Rust / Cargo
/target/
**/*.rs.bk

# Local heavy artifacts and reference corpora
# Keep published listening demos tracked so README comparison links work.
/artifacts/*
!/artifacts/LISTENING_COMPARE.md
!/artifacts/listening_demo/
!/artifacts/listening_demo/**
!/artifacts/listening_demo_rust/
!/artifacts/listening_demo_rust/**
/artifacts/listening_demo_rust/diag/
**/*.before_fix
/model/
/refs/

# Local tools / caches
/.cache/
/.tmp/
/.temp/
*.log

# Python / virtualenv
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/venv/

# Editor / OS
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Generated audio / exports
*.wav
*.mp3
*.flac
*.ogg
*.jsonl

# Allow published listening-demo WAVs (and keep other generated audio ignored)
!artifacts/listening_demo/**/*.wav
!artifacts/listening_demo_rust/**/*.wav
artifacts/listening_demo_rust/diag/**

# Keep these root files versioned if explicitly added later
!Cargo.toml
!Cargo.lock
!README.md
!.gitattributes
